# Copy to backend/.env. Keep real values out of source control.

# Bind to loopback for local use. For an isolated VM lab, set this to the
# Windows host-only adapter IP and firewall the port to the lab subnet only.
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application database: SQLite is the local-only default.
# For PostgreSQL, replace the password below and set this URL to the same values.
# DATABASE_URL=postgresql+asyncpg://sentinel:CHANGE_ME@localhost:5432/sentinel_db
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
POSTGRES_DB=sentinel_db

# Sensor-to-SentinelAI credentials. Generate separate random values for both.
SURICATA_INGEST_TOKEN=CHANGE_ME_SURICATA_TOKEN
WAZUH_INGEST_TOKEN=CHANGE_ME_WAZUH_TOKEN

# Select one LLM provider: groq or gemini. Never put keys in frontend code.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional public threat-intelligence enrichment.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Optional Qdrant Cloud semantic search. FastEmbed creates vectors locally.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sentinelai_knowledge
QDRANT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional LangSmith tracing. Keep disabled until trace data has privacy approval.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=sentinelai-dev

# Auth settings are placeholders only; API user authentication is not implemented yet.
SECRET_KEY=CHANGE_ME_BEFORE_ANY_DEPLOYMENT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
